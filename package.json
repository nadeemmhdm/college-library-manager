{
  "name": "college-library-manager",
  "version": "1.0.3",
  "description": "Offline-First Windows Desktop Library Management Software for College Libraries",
  "main": "dist-electron/main/main.js",
  "author": "NM Developers",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run build:electron && electron .\"",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis portable",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "boxicons": "^2.1.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.3.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "papaparse": "^5.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "overrides": {
    "tar": "^7.5.3",
    "builder-util-runtime": "^9.7.0"
  },
  "build": {
    "appId": "com.nmdevelopers.collegelibrarymanager",
    "productName": "College Library Manager",
    "copyright": "Copyright © 2026 NM Developers",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "publisherName": "NM Developers",
      "legalTrademarks": "NM Developers",
      "sign": null,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "College Library Manager",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "CollegeLibraryManager-Setup-x64.exe"
    },
    "portable": {
      "artifactName": "CollegeLibraryManager-Portable-x64.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nadeemmhdm",
        "repo": "college-library-manager"
      }
    ]
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.25.12": true,
    "core-js@3.51.0": true
  }
}
